{
  "expo": {
    "name": "Y2K Home",
    "slug": "y2k-home",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "y2khome",
    "userInterfaceStyle": "light",
    "ios": {
      "appleTeamId": "ZGB8YMCMU3",
      "bundleIdentifier": "com.jaylonwlv.y2khome",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jaylonwlv.y2khome"
        ]
      }
    },
    "android": {
      "package": "com.jaylonwlv.y2khome",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4C6EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Your calendar events show up on your home screen widgets.",
          "remindersPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Pick photos for your widgets.",
          "savePhotosPermission": "Save wallpapers to your photo library so you can set them as your wallpaper."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Geist-Medium.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/Geist-Black.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos for your widgets.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.jaylonwlv.y2khome.widget",
                  "targetName": "widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jaylonwlv.y2khome"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "910f2ed9-e6e5-4bb5-884c-f121a80063d8"
      }
    },
    "owner": "jayftr"
  }
}
